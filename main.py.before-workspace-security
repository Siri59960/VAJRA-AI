# ---------- Gemini chat ----------

@app.post("/api/chat")
def chat(request: ChatRequest, current_user: User = Depends(get_current_user)):
    if client is None:
        raise HTTPException(
            status_code=503,
            detail="Gemini API key is missing. Configure GEMINI_API_KEY.",
        )

    message = request.message.strip()
    if not message:
        raise HTTPException(status_code=400, detail="Message cannot be empty.")

    system_instruction = """
You are VAJRA AI OS, the operations assistant for Team VAJRA.

You can answer questions and use tools to create/list tasks and projects.
Use tools when the user explicitly asks to create or list records.
Never claim an action succeeded unless the tool result confirms it.
For creating a project, ask a concise follow-up if its name is missing.
Do not claim to access email, files, external websites, or robot telemetry
unless an implemented tool provides that access.
Keep routine answers concise and practical.
"""

    try:
        response = client.models.generate_content(
            model=MODEL_NAME,
            contents=message,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction,
                tools=[create_task, list_tasks, create_project, list_projects],
                max_output_tokens=500,
            ),
        )

        reply = response.text or "Gemini returned no text. Please try again."
        return {"reply": reply, "model": MODEL_NAME}

    except Exception as exc:
        logger.exception("Gemini request failed")
        raise HTTPException(
            status_code=502,
            detail="Gemini request failed. Check server logs and API quota.",
        ) from exc
