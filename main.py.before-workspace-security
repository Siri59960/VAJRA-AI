# ---------- Serialization helpers ----------

def project_dict(project: Project, task_count: int | None = None) -> dict:
    return {
        "id": project.id,
        "name": project.name,
        "description": project.description,
        "status": project.status,
        "deadline": project.deadline.isoformat() if project.deadline else None,
        "created_at": project.created_at.isoformat(),
        "task_count": task_count,
    }


def task_dict(task: Task) -> dict:
    return {
        "id": task.id,
        "title": task.title,
        "description": task.description,
        "priority": task.priority,
        "status": task.status,
        "project_id": task.project_id,
        "project_name": task.project.name if task.project else None,
        "created_at": task.created_at.isoformat(),
        "completed_at": task.completed_at.isoformat() if task.completed_at else None,
    }


# ---------- Database-backed tools for Gemini ----------

def create_task(
    title: str,
    description: str = "",
    priority: str = "medium",
    project_id: str = "",
) -> dict:
    """Create a task in VAJRA.

    Args:
        title: Short task title.
        description: Details about the task.
        priority: Task priority: low, medium, or high.
        project_id: Optional ID of the project this task belongs to.
    """
    title = title.strip()
    if not title:
        return {"success": False, "error": "Task title cannot be empty."}

    priority = priority.lower().strip()
    if priority not in {"low", "medium", "high"}:
        priority = "medium"

    project_id = project_id.strip() or None

    with SessionLocal() as db:
        if project_id and not db.get(Project, project_id):
            return {"success": False, "error": "Project ID was not found."}

        task = Task(
            title=title,
            description=description.strip(),
            priority=priority,
            status="open",
            project_id=project_id,
        )
        db.add(task)
        db.commit()
        db.refresh(task)
        result = task_dict(task)
        return {"success": True, "task": result}


def list_tasks(status: str = "all", project_id: str = "") -> dict:
    """List VAJRA tasks.

    Args:
        status: Filter by all, open, or completed.
        project_id: Optional project ID to filter tasks.
    """
    status = status.lower().strip()
    if status not in {"all", "open", "completed"}:
        status = "all"

    with SessionLocal() as db:
        stmt = select(Task).order_by(Task.created_at.desc())
        if status != "all":
            stmt = stmt.where(Task.status == status)
        if project_id.strip():
            stmt = stmt.where(Task.project_id == project_id.strip())

        rows = db.scalars(stmt).all()
        return {"count": len(rows), "tasks": [task_dict(t) for t in rows]}


def create_project(
    name: str,
    description: str = "",
    deadline: str = "",
) -> dict:
    """Create a VAJRA project.

    Args:
        name: Project name.
        description: Project purpose and scope.
        deadline: Optional deadline in YYYY-MM-DD format.
    """
    name = name.strip()
    if not name:
        return {"success": False, "error": "Project name cannot be empty."}

    parsed_deadline = None
    if deadline.strip():
        try:
            parsed_deadline = date.fromisoformat(deadline.strip())
        except ValueError:
            return {"success": False, "error": "Deadline must use YYYY-MM-DD."}

    with SessionLocal() as db:
        project = Project(
            name=name,
            description=description.strip(),
            status="active",
            deadline=parsed_deadline,
        )
        db.add(project)
        db.commit()
        db.refresh(project)
        return {"success": True, "project": project_dict(project, 0)}


def list_projects(status: str = "all") -> dict:
    """List VAJRA projects.

    Args:
        status: Filter by all, active, completed, or on_hold.
    """
    status = status.lower().strip()
    allowed = {"all", "active", "completed", "on_hold"}
    if status not in allowed:
        status = "all"

    with SessionLocal() as db:
        stmt = select(Project).order_by(Project.created_at.desc())
        if status != "all":
            stmt = stmt.where(Project.status == status)

        projects = db.scalars(stmt).all()
        results = []
        for project in projects:
            count = db.scalar(
                select(func.count(Task.id)).where(Task.project_id == project.id)
            ) or 0
            results.append(project_dict(project, count))

        return {"count": len(results), "projects": results}


# ---------- Authentication API ----------

@app.post("/api/auth/register", status_code=status.HTTP_201_CREATED)
def register(request: RegisterRequest, db: Session = Depends(get_db)):
    configured_invite = os.getenv("TEAM_INVITE_CODE", "")
    if not configured_invite or len(configured_invite) < 16:
        raise HTTPException(status_code=503, detail="Team registration is not configured. Set TEAM_INVITE_CODE.")
    if not __import__("hmac").compare_digest(request.invite_code, configured_invite):
        raise HTTPException(status_code=403, detail="Invalid team invitation code.")
    if not JWT_SECRET_KEY or len(JWT_SECRET_KEY) < 32:
        raise HTTPException(status_code=503, detail="Authentication is not configured securely.")

    email = request.email.strip().lower()
    if not __import__("re").fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        raise HTTPException(status_code=422, detail="Enter a valid email address.")
    existing = db.scalar(select(User).where(func.lower(User.email) == email))
    if existing:
        # Avoid disclosing whether an email is registered.
        raise HTTPException(status_code=409, detail="Unable to register this email address.")

    user = User(email=email, password_hash=password_hash.hash(request.password))
    db.add(user)
    try:
        db.commit()
    except Exception:
        db.rollback()
        logger.exception("User registration failed")
        raise HTTPException(status_code=409, detail="Unable to register this email address.") from None
    db.refresh(user)
    token = create_access_token(user.id)
    return {"access_token": token, "token_type": "bearer", "expires_in": ACCESS_TOKEN_EXPIRE_MINUTES * 60,
            "user": {"id": user.id, "email": user.email}}


@app.post("/api/auth/login")
def login(
    form_data: OAuth2PasswordRequestForm = Depends(),
    db: Session = Depends(get_db),
):
    """Exchange OAuth2 form credentials for a bearer access token.

    Swagger sends the email address in the OAuth2 `username` field.
    """
    if not JWT_SECRET_KEY or len(JWT_SECRET_KEY) < 32:
        raise HTTPException(
            status_code=503,
            detail="Authentication is not configured securely.",
        )

    email = form_data.username.strip().lower()
    if not __import__("re").fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )

    user = db.scalar(select(User).where(func.lower(User.email) == email))
    if user is None or not password_hash.verify(form_data.password, user.password_hash):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )

    token = create_access_token(user.id)
    return {
        "access_token": token,
        "token_type": "bearer",
        "expires_in": ACCESS_TOKEN_EXPIRE_MINUTES * 60,
        "user": {"id": user.id, "email": user.email},
    }


@app.get("/api/auth/me")
def auth_me(current_user: User = Depends(get_current_user)):
