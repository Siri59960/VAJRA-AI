@app.get("/api/tasks")
def get_tasks(
    status: str = Query(default="all"),
    project_id: str | None = None,
    current_user: User = Depends(get_current_user),
):
    if status not in {"all", "open", "completed"}:
        raise HTTPException(status_code=400, detail="Invalid task status.")
    return list_tasks(status, project_id or "")


@app.post("/api/tasks")
def add_task(request: TaskCreate, current_user: User = Depends(get_current_user)):
    result = create_task(
        title=request.title,
        description=request.description,
        priority=request.priority,
        project_id=request.project_id or "",
    )
    if not result["success"]:
        raise HTTPException(status_code=400, detail=result["error"])
    return result


@app.patch("/api/tasks/{task_id}")
def update_task(task_id: str, request: TaskUpdate, current_user: User = Depends(get_current_user)):
    allowed_priorities = {"low", "medium", "high"}
    allowed_statuses = {"open", "completed"}

    with SessionLocal() as db:
        task = db.get(Task, task_id)
        if not task:
            raise HTTPException(status_code=404, detail="Task not found.")

        values = request.model_dump(exclude_unset=True)

        if "title" in values and values["title"] is not None:
            if not values["title"].strip():
                raise HTTPException(status_code=400, detail="Title cannot be empty.")
            task.title = values["title"].strip()

        if "description" in values and values["description"] is not None:
            task.description = values["description"].strip()

        if "priority" in values and values["priority"] is not None:
            if values["priority"] not in allowed_priorities:
                raise HTTPException(status_code=400, detail="Invalid priority.")
            task.priority = values["priority"]

        if "status" in values and values["status"] is not None:
            if values["status"] not in allowed_statuses:
                raise HTTPException(status_code=400, detail="Invalid status.")
            task.status = values["status"]
            task.completed_at = (
                datetime.now(timezone.utc) if task.status == "completed" else None
            )

        if "project_id" in values:
            new_project_id = values["project_id"]
            if new_project_id and not db.get(Project, new_project_id):
                raise HTTPException(status_code=400, detail="Project not found.")
            task.project_id = new_project_id

        db.commit()
        db.refresh(task)
        return {"success": True, "task": task_dict(task)}


@app.post("/api/tasks/{task_id}/complete")
def mark_task_complete(task_id: str, current_user: User = Depends(get_current_user)):
    with SessionLocal() as db:
        task = db.get(Task, task_id)
        if not task:
            raise HTTPException(status_code=404, detail="Task not found.")

        task.status = "completed"
        task.completed_at = datetime.now(timezone.utc)
        db.commit()
        db.refresh(task)
        return {"success": True, "task": task_dict(task)}


